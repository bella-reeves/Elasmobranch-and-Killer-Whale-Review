

# LOAD LIBRARIES

library(tidyverse)
library(lme4)
library(MuMIn)

options(na.action = "na.fail")


# LOAD DATA

df <- read.csv("Data_rawinput_morph.csv", stringsAsFactors = FALSE)
colnames(df) <- make.names(colnames(df))


# CLEAN + FORMAT

df[df == ""] <- NA

df <- df %>%
  mutate(
    Interaction.Type = as.factor(Interaction.Type),
    Morphology = as.factor(Morphology),
    Trophic.Guild = as.factor(Trophic.Guild),
    Interaction.Habitat = as.factor(Interaction.Habitat),
    Country = as.factor(Country),
    Source = as.factor(Source),
    Latitude = as.numeric(as.character(Latitude)),
    Trophic.position = as.numeric(as.character(Trophic.position))
  )


# 5. DEFINE RESPONSE

df <- df %>%
  mutate(
    interaction_binary = case_when(
      Interaction.Type %in% c("KWC", "KIL", "DEP") ~ "consumptive",
      Interaction.Type %in% c("ATT", "AVO", "COE", "HAR", "DEF", "SCA", "OTH", "PAR") ~ "non_consumptive",
      TRUE ~ NA_character_
    )
  ) %>%
  mutate(interaction_binary = as.factor(interaction_binary)) %>%
  drop_na(interaction_binary, Morphology, Source, Latitude, Trophic.position)


# 6. ASSOCIATION TESTS (SUMMARY ONLY)

chi_test <- chisq.test(table(df$interaction_binary, df$Morphology), simulate.p.value = TRUE)

cor_test <- cor.test(df$Trophic.position, df$Latitude, method = "spearman")


7. GLMM MODELS

m_morph <- glmer(
  interaction_binary ~ Morphology + (1 | Source),
  data = df,
  family = binomial
)

m_lat <- glmer(
  interaction_binary ~ Latitude + (1 | Source),
  data = df,
  family = binomial
)

m_both <- glmer(
  interaction_binary ~ Morphology + Latitude + (1 | Source),
  data = df,
  family = binomial
)


# MODEL COMPARISON

aic_results <- AIC(m_morph, m_lat, m_both)
anova_results <- anova(m_morph, m_both)


# R² CALCULATION

r2_morph <- r.squaredGLMM(m_morph)
r2_lat   <- r.squaredGLMM(m_lat)
r2_both  <- r.squaredGLMM(m_both)


# WRITE OUTPUT TO FILE

sink("GLMM_results.txt")

cat("===== ASSOCIATION TESTS =====\n\n")
print(chi_test)

cat("\n===== CORRELATION =====\n\n")
print(cor_test)

cat("\n===== MODEL COMPARISON (AIC) =====\n\n")
print(aic_results)

cat("\n===== MODEL COMPARISON (ANOVA) =====\n\n")
print(anova_results)

cat("\n===== MODEL SUMMARIES =====\n\n")
cat("\n--- Morphology Model ---\n")
print(summary(m_morph))

cat("\n--- Latitude Model ---\n")
print(summary(m_lat))

cat("\n--- Combined Model ---\n")
print(summary(m_both))

cat("\n===== R² VALUES =====\n\n")
cat("\nMorphology Model:\n")
print(r2_morph)

cat("\nLatitude Model:\n")
print(r2_lat)

cat("\nCombined Model:\n")
print(r2_both)

sink()

cat("✅ Output written to: GLMM_results.txt\n")
